# Copy to .env (never commit .env). Values here override ${VAR:default} in config/config.yaml.

# LLM profile: local | local_installed | openai | vllm | mock
CALLINTEL_PROFILE=local

# OpenAI (only needed for the "openai" profile)
OPENAI_API_KEY=
# OPENAI_BASE_URL=           # e.g. Azure OpenAI / proxy endpoint

# Local servers
OLLAMA_BASE_URL=http://127.0.0.1:11434
# VLLM_BASE_URL=http://gpu-server:8000/v1
# VLLM_API_KEY=EMPTY

# Redis (>= 6.2). Use 127.0.0.1, not localhost: on Windows localhost tries IPv6 first (~2 s per connect)
REDIS_URL=redis://127.0.0.1:6379/0

# Optional reversible pseudonymisation vault (privacy.vault.enabled=true)
# generate with: python -m callintel vault-key
# PII_VAULT_KEY=
